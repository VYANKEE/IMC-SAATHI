# ─────────────────────────────────────────────────────────────
# server/.env  —  copy this file to server/.env, then fill in real values.
#
# This file (.env.example) IS committed to git — it has no real secrets,
# only variable names and safe non-secret defaults, so it's how a new
# developer (or a deploy pipeline) knows what to configure.
#
# server/.env itself is NEVER committed (.gitignore) and never sent to the
# browser. For deployment, don't hand this file around by chat/email/git —
# each teammate or environment (local dev, staging, prod on Render, etc.)
# gets its own real values, set either in their own local server/.env or
# directly in the hosting platform's environment-variables UI (Render:
# Dashboard -> service -> Environment). The values themselves (API keys,
# the Atlas connection string) should move through a password manager or
# the platform's own secret store — never through Slack/WhatsApp/git.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call this API. Add your
# deployed frontend's real origin here too once it exists (comma-separated,
# no trailing slash) -- a request from an origin not on this list gets a
# 403 CORS_NOT_ALLOWED, on purpose.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# ---- Database ----
# MongoDB Atlas connection string. If you ever see "querySrv EBADRESP" on
# Windows, that's a known Node/Windows DNS quirk (docs/11-decisions.md), not
# a bad URI -- switch the mongodb+srv:// form to a direct, non-SRV
# mongodb://host1,host2,host3/... string built from the SRV/TXT records.
MONGODB_URI=

# ---- AI: NVIDIA NIM, both chat AND embeddings (docs/11-decisions.md D15, D16 + addenda) ----
# Get a key at https://build.nvidia.com. One key covers both variables below.
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b
EMBEDDING_DIMENSIONS=768

# ---- NOT required for the current backend/demo. Placeholders for later
#      phases only -- leave blank until that phase is actually being built.
#      Nothing in server/src reads these yet. ----

# Firebase Admin (Phase 8 — authentication. Explicitly out of scope for the
# current backend work; do not wire this up without checking with the team
# first, since Phase 8 has its own separate design).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Media uploads (Phase 11 — not started).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

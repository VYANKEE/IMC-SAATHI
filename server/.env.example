# ─────────────────────────────────────────────────────────────
# server/.env  —  copy this file to server/.env
# Never committed. Never sent to the browser.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Database (Phase 2) ----
MONGODB_URI=

# ---- AI (Phase 4) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Embeddings — NVIDIA NIM (docs/11-decisions.md D15)
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
EMBEDDING_DIMENSIONS=768

# ---- Firebase Admin (Phase 8) ----
# The service account. This must NEVER appear in client code or in git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Media (Phase 11) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── dependencies ──────────────────────────────────────────────
node_modules/

# ── environment: NEVER commit real secrets ───────────────────
.env
.env.local
.env.*.local
*-service-account*.json
serviceAccountKey.json

# ── build output ─────────────────────────────────────────────
dist/
build/
.vite/

# ── logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── tests ────────────────────────────────────────────────────
coverage/

# ── ingestion output (regenerated by `npm run ingest`) ───────
server/data/processed/*
!server/data/processed/.gitkeep
server/ingestion-report.json

# ── editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# .vscode is committed on purpose — shared formatter and lint settings.
# Only personal, machine-specific files are excluded.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

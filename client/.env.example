# ─────────────────────────────────────────────────────────────
# client/.env  —  copy this file to client/.env
#
# WARNING: every VITE_ variable is compiled into the JavaScript bundle
# and is readable by anyone who opens the site. Public values ONLY.
# A secret here is a leaked secret. See docs/08-security.md.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:5000/api

# Firebase client config (Phase 8).
# These are public by design — Firebase security comes from rules and from
# server-side token verification, not from hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
